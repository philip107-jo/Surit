<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.surit.user.mapper.UserMapper">
 
 <select id="countByUserId" parameterType="string" resultType="int">
 SELECT COUNT(*) FROM USERS WHERE USER_ID = #{userId}
 
 </select>
 
 <select id="selectByUserId" parameterType="string" resultType="com.surit.user.model.dto.UserDTO">
 SELECT USER_NO,USER_ID,EMAIL,
    PASSWORD, NAME,USER_ROLE,
    TO_CHAR(CREATED_AT, 'YYYY-MM-DD HH24:MI') AS CREATED_AT_STR
    FROM USERS
    WHERE USER_ID = #{userId}
 
 </select>
 
 <delete id="deleteUser" parameterType="string">
 DELETE FROM USERS WHERE USER_ID = #{userId}
 </delete>
<!--
============================================================
파일: resources/mappers/UserMapper.xml
기존 insertUser <insert> 를 이걸로 교체하세요.
 
USER_ROLE, STATUS 는 DB 기본값이 있지만(각각 'USER', 'ACTIVE'),
회원가입 폼에서 USER/FIXER 를 직접 선택하게 되어 있으므로
USER_ROLE 은 명시적으로 넣어줌. STATUS 는 기본값(ACTIVE) 그대로 사용.
============================================================
-->
 
<insert id="insertUser" useGeneratedKeys="true" keyProperty="userNo" keyColumn="USER_NO">
    INSERT INTO USERS (
        USER_ID, EMAIL, PASSWORD, NAME, PHONE, USER_ROLE
    )
    VALUES (
        #{userId}, #{email}, #{password}, #{name}, #{phone}, #{userRole}
    )
</insert>
 
</mapper>

