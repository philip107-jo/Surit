<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.surit.fixer.verify.model.mapper.FixerMapper">

	<!-- ================= 조회 ================= -->

	<select id="selectFixerProfile" parameterType="int"
	        resultType="com.surit.fixer.verify.model.dto.FixerProfileDTO">
		SELECT USER_NO, INTRO, CAREER_YEARS, APPROVAL_STATUS
		  FROM FIXER_PROFILE
		 WHERE USER_NO = #{userNo}
	</select>

	<select id="selectLicensesByUserNo" parameterType="int"
	        resultType="com.surit.fixer.verify.model.dto.FixerLicenseDTO">
		SELECT LICENSE_ID, USER_NO, LICENSE_NAME, UPLOAD_URL, ISSUED_AT
		  FROM FIXER_LICENSE
		 WHERE USER_NO = #{userNo}
		 ORDER BY LICENSE_ID
	</select>

	<!-- ================= 등록 / 수정 ================= -->

	<!-- 신규 신청 : 상태는 무조건 PENDING 으로 시작 -->
	<insert id="insertFixerProfile"
	        parameterType="com.surit.fixer.verify.model.dto.FixerProfileDTO">
		INSERT INTO FIXER_PROFILE (
			USER_NO, INTRO, CAREER_YEARS, APPROVAL_STATUS
		) VALUES (
			#{userNo}, #{intro}, #{careerYears}, 'PENDING'
		)
	</insert>

	<!-- 재신청 : REJECTED 상태에서만 다시 PENDING 으로 되돌린다.
	     WHERE 에 상태 조건을 넣어서, 조회한 뒤 여기까지 오는 사이에
	     관리자가 승인해버렸다면 0건이 수정되도록 한다 -->
	<update id="updateFixerProfile"
	        parameterType="com.surit.fixer.verify.model.dto.FixerProfileDTO">
		UPDATE FIXER_PROFILE
		   SET INTRO           = #{intro},
		       CAREER_YEARS    = #{careerYears},
		       APPROVAL_STATUS = 'PENDING'
		 WHERE USER_NO         = #{userNo}
		   AND APPROVAL_STATUS = 'REJECTED'
	</update>

	<!-- LICENSE_ID 는 IDENTITY 라 컬럼에서 아예 뺀다 (DB가 채워줌) -->
	<insert id="insertFixerLicense"
	        parameterType="com.surit.fixer.verify.model.dto.FixerLicenseDTO">
		INSERT INTO FIXER_LICENSE (
			USER_NO, LICENSE_NAME, UPLOAD_URL, ISSUED_AT
		) VALUES (
			#{userNo}, #{licenseName}, #{uploadUrl}, #{issuedAt}
		)
	</insert>

	<insert id="insertFixerRegion">
		INSERT INTO FIXER_REGION (USER_NO, REGION_CODE)
		VALUES (#{userNo}, #{regionCode})
	</insert>

	<insert id="insertFixerCategory">
		INSERT INTO FIXER_CATEGORY (USER_NO, CATEGORY_CODE)
		VALUES (#{userNo}, #{categoryCode})
	</insert>

	<!-- ================= 삭제 ================= -->

	<delete id="deleteLicensesByUserNo" parameterType="int">
		DELETE FROM FIXER_LICENSE WHERE USER_NO = #{userNo}
	</delete>

	<delete id="deleteRegionsByUserNo" parameterType="int">
		DELETE FROM FIXER_REGION WHERE USER_NO = #{userNo}
	</delete>

	<delete id="deleteCategoriesByUserNo" parameterType="int">
		DELETE FROM FIXER_CATEGORY WHERE USER_NO = #{userNo}
	</delete>

</mapper>
