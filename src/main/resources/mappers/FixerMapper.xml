<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.surit.fixer.verify.model.mapper.FixerMapper">

	<!-- ================= 조회 ================= -->

	<!-- FIXER_PHOTO_URL 에 PHOTO_URL 별칭을 붙이는 이유 :
	     map-underscore-to-camel-case 가 켜져 있어서 MyBatis 는
	     FIXER_PHOTO_URL 을 fixerPhotoUrl 로 바꿔 DTO 필드를 찾는다.
	     그런데 DTO 필드 이름은 photoUrl 이라 이름이 어긋나고,
	     MyBatis 는 에러 없이 조용히 건너뛰어 값이 null 이 된다.
	     (INSERT/UPDATE 는 #{photoUrl} 로 직접 지정해서 영향 없음 → 읽기만 깨짐)
	     별칭을 주면 PHOTO_URL → photoUrl 로 정확히 맞는다. -->


	<!-- REJECT_REASON 을 같이 읽는 이유 :
	     관리자가 거절할 때 남긴 사유를 기사 화면(verify.jsp)에 보여주기 위함.
	     이 컬럼은 관리자 기능에서 채우고 여기서는 읽기만 한다.
	     (재신청 시 NULL 로 비우는 것은 updateFixerProfile 의 SQL 에 직접 박혀 있다)
	     거절된 적이 없거나 관리자가 사유를 안 적었으면 null 이므로
	     화면에서 empty 검사를 하고 출력한다. -->

	<select id="selectFixerProfile" parameterType="long"

	        resultType="com.surit.fixer.verify.model.dto.FixerProfileDTO">
		SELECT USER_NO, INTRO, CAREER_YEARS, APPROVAL_STATUS,
		       FIXER_PHOTO_URL AS PHOTO_URL,
		       REJECT_REASON
		  FROM FIXER_PROFILE
		 WHERE USER_NO = #{userNo}
	</select>

	<select id="selectLicensesByUserNo" 
	        parameterType="Long"
	        resultType="com.surit.fixer.verify.model.dto.FixerLicenseDTO">
		SELECT LICENSE_ID, USER_NO, LICENSE_NAME, UPLOAD_URL, ISSUED_AT
		  FROM FIXER_LICENSE
		 WHERE USER_NO = #{userNo}
		 ORDER BY LICENSE_ID
	</select>

	<!-- ================= 등록 / 수정 ================= -->

	<!-- 신규 신청 : 상태는 무조건 PENDING 으로 시작 -->
	<insert id="insertFixerProfile"
	        parameterType="com.surit.fixer.verify.model.dto.FixerProfileDTO">
		INSERT INTO FIXER_PROFILE (
			USER_NO, INTRO, CAREER_YEARS, APPROVAL_STATUS, FIXER_PHOTO_URL
		) VALUES (
			#{userNo}, #{intro}, #{careerYears}, 'PENDING', #{photoUrl}
		)
	</insert>

	<!-- 재신청 : REJECTED 상태에서만 다시 PENDING 으로 되돌린다.
	     WHERE 에 상태 조건을 넣어서, 조회한 뒤 여기까지 오는 사이에
	     관리자가 승인해버렸다면 0건이 수정되도록 한다.

	     REJECT_REASON / APPROVED_AT 을 NULL 로 비우는 이유 :
	     이 두 컬럼은 관리자 심사 결과를 담는 값이라, 다시 '심사 대기(PENDING)'
	     로 되돌리는 시점에는 둘 다 성립하지 않는 값이 된다.
	     안 지우면 재신청 건에 지난번 거절 사유가 그대로 붙어 있어서,
	     관리자도 기사도 옛 심사 결과를 현재 것으로 오해하게 된다. -->
	<update id="updateFixerProfile"
	        parameterType="com.surit.fixer.verify.model.dto.FixerProfileDTO">
		UPDATE FIXER_PROFILE
		   SET INTRO           = #{intro},
		       CAREER_YEARS    = #{careerYears},
		       APPROVAL_STATUS = 'PENDING',
		       FIXER_PHOTO_URL = #{photoUrl},
		       REJECT_REASON   = NULL,
		       APPROVED_AT     = NULL
		 WHERE USER_NO         = #{userNo}
		   AND APPROVAL_STATUS = 'REJECTED'
	</update>

	<!-- LICENSE_ID 는 IDENTITY 라 컬럼에서 아예 뺀다 (DB가 채워줌) -->
	<insert id="insertFixerLicense"
	        parameterType="com.surit.fixer.verify.model.dto.FixerLicenseDTO">
		INSERT INTO FIXER_LICENSE (
			USER_NO, LICENSE_NAME, UPLOAD_URL, ISSUED_AT
		) VALUES (
			#{userNo}, #{licenseName}, #{uploadUrl}, #{issuedAt}
		)
	</insert>

	<insert id="insertFixerRegion">
		INSERT INTO FIXER_REGION (USER_NO, REGION_CODE)
		VALUES (#{userNo}, #{regionCode})
	</insert>

	<insert id="insertFixerCategory">
		INSERT INTO FIXER_CATEGORY (USER_NO, CATEGORY_CODE)
		VALUES (#{userNo}, #{categoryCode})
	</insert>

	<!-- ================= 삭제 ================= -->

	<delete id="deleteLicensesByUserNo" parameterType="Long">
		DELETE FROM FIXER_LICENSE WHERE USER_NO = #{userNo}
	</delete>

	<delete id="deleteRegionsByUserNo" parameterType="Long">
		DELETE FROM FIXER_REGION WHERE USER_NO = #{userNo}
	</delete>

	<delete id="deleteCategoriesByUserNo" parameterType="Long">
		DELETE FROM FIXER_CATEGORY WHERE USER_NO = #{userNo}
	</delete>

</mapper>