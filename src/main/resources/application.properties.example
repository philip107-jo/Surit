spring.application.name=surit

server.port=8989

# JSP 화면 경로 설정
spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp

# DB 접속 정보
spring.datasource.url=값은 알아서
spring.datasource.username=값은 알아서
spring.datasource.password=값은 알아서
spring.datasource.driver-class-name=값은 알아서

# MyBatis 설정
# type-aliases-package 를 com.surit 로 잡아야
# UserMapper.xml 의 resultType="UserDTO" 같은 짧은 이름이 해석된다
mybatis.mapper-locations=classpath:mappers/**/*.xml
mybatis.type-aliases-package=com.surit
mybatis.configuration.jdbc-type-for-null=NULL
mybatis.configuration.map-underscore-to-camel-case=true

# 개발 중 SQL 확인용 (에러 잡을 때 필수)
logging.level.com.surit=DEBUG

# 파일 업로드 크기 제한
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB

# 파일 저장 경로
file.upload-dir=uploads
file.upload-dir.license=uploads/license
file.web-prefix.license=/uploads/license
file.upload-dir.photo=uploads/photo
file.web-prefix.photo=/uploads/photo

# 에러 화면에 스택트레이스가 노출되지 않도록 차단.
# 노출되면 프레임워크 버전·내부 클래스 경로·필터체인 구조까지 드러나
# 공격자에게 서버 구조 정보를 제공하게 된다.
# 상태코드와 에러 응답 자체는 그대로 동작한다.
server.error.include-stacktrace=never